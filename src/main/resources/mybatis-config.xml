<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE configuration PUBLIC "-//mybatis.org//DTD Config 3.0//EN" "http://mybatis.org/dtd/mybatis-3-config.dtd">
<configuration>
    <!-- 설정 -->
    <settings>
        <!-- 카멜케이스 자동 매핑 -->
        <setting name="mapUnderscoreToCamelCase" value="true"/>
        <!-- 쿼리 결과가 null인 경우에도 컬럼 포함 -->
        <setting name="callSettersOnNulls" value="true"/>
        <!-- 쿼리 실행 시 실제 구문을 로그로 출력 -->
        <setting name="logImpl" value="SLF4J"/>
    </settings>

    <!-- 타입 별칭 설정 -->
    <typeAliases>
        <!-- User 관련 별칭 -->
        <typeAlias type="com.board.plan.user.model.User" alias="User"/>
        
        <!-- Member 관련 별칭 -->
        <typeAlias type="com.board.plan.member.dto.MemberDto" alias="MemberDto"/>
        
        <!-- Schedule 관련 별칭 -->
        <typeAlias type="com.board.plan.schedule.model.Schedule" alias="Schedule"/>
        <typeAlias type="com.board.plan.schedule.model.ScheduleParticipant" alias="ScheduleParticipant"/>
        
        <!-- Leave 관련 별칭 -->
        <typeAlias type="com.board.plan.leave.model.LeaveRequest" alias="LeaveRequest"/>
        <typeAlias type="com.board.plan.leave.model.LeaveApproval" alias="LeaveApproval"/>
        
        <!-- Role 관련 별칭 -->
        <typeAlias type="com.board.plan.role.model.Role" alias="Role"/>
        <typeAlias type="com.board.plan.role.model.Permission" alias="Permission"/>
        <typeAlias type="com.board.plan.role.model.RolePermission" alias="RolePermission"/>
    </typeAliases>
</configuration> 